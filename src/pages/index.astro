---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import EventCard from "../components/EventCard.astro";
import ContactForm from "../components/ContactForm.astro";
import { site } from "../site.config";
import { isUpcoming } from "../lib/dates";

const homeEntry = await getEntry("home", "home");
if (!homeEntry) {
  throw new Error("src/content/home.yaml is missing its top-level `home:` key");
}
const home = homeEntry.data;

// One icon per program pillar. The CMS only offers these three by name
// (public/admin/config.yml), so a mismatch here is a code change, not an
// editor mistake.
const programIcons: Record<string, string> = {
  flame: `<path d="M12 2c1.5 2.5 2 4 2 5.5a2 2 0 1 1-4 0C10 5.5 10.5 4.5 12 2Z"/><path d="M5 14c0-3.5 3-5 7-5s7 1.5 7 5c0 4-3 7-7 7s-7-3-7-7Z"/>`,
  book: `<path d="M4 5.5C4 4.67 4.67 4 5.5 4H12v16H5.5A1.5 1.5 0 0 1 4 18.5v-13Z"/><path d="M20 5.5c0-.83-.67-1.5-1.5-1.5H12v16h6.5c.83 0 1.5-.67 1.5-1.5v-13Z"/>`,
  heart: `<path d="M12 20s-7-4.35-9.5-8.8C1 8.3 2.4 5 5.6 5c1.9 0 3.3 1 4.4 2.6C11.1 6 12.5 5 14.4 5 17.6 5 19 8.3 17.5 11.2 15 15.65 12 20 12 20Z"/>`,
};

// The filter runs at build time, so the homepage is only as fresh as the last
// deploy. Netlify rebuilds on every merge, which is enough for a site whose
// content changes a few times a month.
const events = await getCollection("events", ({ data }) => !data.draft);

const upcoming = events
  .filter(({ data }) => isUpcoming(data.date, data.endDate))
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 3);

// A grid built for three cards looks unfinished with one or two, so the
// column count and a width cap track how many are actually there.
const upcomingColsClass =
  upcoming.length === 1
    ? "sm:grid-cols-1"
    : upcoming.length === 2
      ? "sm:grid-cols-2"
      : "sm:grid-cols-2 lg:grid-cols-3";
const upcomingWidthClass =
  upcoming.length === 1 ? "max-w-sm" : upcoming.length === 2 ? "max-w-3xl" : "";
---

<BaseLayout title={site.name} description={site.description}>
  <section class="border-b border-sindoor-100 bg-gradient-to-b from-sindoor-50 to-cream">
    <Container class="grid items-center gap-12 py-16 sm:py-20 lg:grid-cols-2 lg:gap-16 lg:py-24">
      <div>
        <p lang="bn" class="text-lg text-sindoor-700">{home.hero.kicker}</p>
        <h1 class="mt-2 text-4xl leading-tight font-bold text-ink sm:text-5xl">
          {home.hero.heading}
        </h1>
        <span class="mt-4 block h-1 w-16 rounded-full bg-marigold-500" aria-hidden="true"></span>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-soft">
          {home.hero.description}
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/events/"
            class="rounded-md bg-sindoor-600 px-6 py-3 font-semibold text-white transition-colors hover:bg-sindoor-700"
          >
            See upcoming events
          </a>
          <a
            href={site.zeffy.membershipUrl}
            target="_blank"
            rel="noopener"
            class="rounded-md border border-sindoor-300 bg-white px-6 py-3 font-semibold text-sindoor-700 transition-colors hover:bg-sindoor-50"
          >
            Become a member
          </a>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-sm lg:max-w-none">
        <div
          class="absolute -top-4 -right-4 h-full w-full rounded-2xl bg-marigold-300/60 sm:-top-6 sm:-right-6"
          aria-hidden="true"
        >
        </div>
        <img
          src={home.hero.image}
          alt={home.hero.imageAlt}
          width="825"
          height="1100"
          class="relative aspect-[3/4] w-full rounded-2xl object-cover shadow-xl"
        />
      </div>
    </Container>
  </section>

  <section class="py-16">
    <Container>
      <div class="grid gap-8 sm:grid-cols-3">
        {
          home.programs.map((program) => (
            <div>
              <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-sindoor-50 text-sindoor-600">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-6 w-6"
                  set:html={programIcons[program.icon]}
                />
              </span>
              <h3 class="mt-4 text-lg font-semibold text-ink">{program.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">{program.description}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <section class="py-16">
    <Container>
      <div class="flex items-end justify-between gap-4">
        <h2 class="text-2xl font-bold text-ink">Coming up</h2>
        <a href="/events/" class="text-sm font-medium text-sindoor-700 hover:underline">
          All events
        </a>
      </div>

      {
        upcoming.length > 0 ? (
          <div class:list={["mt-6 grid gap-6", upcomingColsClass, upcomingWidthClass]}>
            {upcoming.map((event) => (
              <EventCard event={event} />
            ))}
          </div>
        ) : (
          <p class="mt-6 rounded-xl border border-dashed border-sindoor-200 bg-white p-8 text-ink-soft">
            Nothing on the calendar right now. Check back soon, or write to us below.
          </p>
        )
      }
    </Container>
  </section>

  {
    home.gallery.length > 0 && (
      <section class="py-16">
        <Container>
          <h2 class="text-2xl font-bold text-ink">From our events</h2>
          <span class="mt-2 block h-1 w-16 rounded-full bg-marigold-500" aria-hidden="true" />
          <p class="mt-3 max-w-2xl text-ink-soft">
            A few moments from recent pujas, performances and community nights.
          </p>
          <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
            {home.gallery.map((photo) => (
              <img
                src={photo.image}
                alt={photo.alt}
                loading="lazy"
                decoding="async"
                class="aspect-square w-full rounded-xl object-cover shadow-sm transition-transform hover:scale-[1.02]"
              />
            ))}
          </div>
        </Container>
      </section>
    )
  }

  <section class="pb-16">
    <Container>
      <div
        class="grid gap-10 rounded-2xl border border-sindoor-100 bg-white p-8 sm:p-10 lg:grid-cols-5"
      >
        <div class="lg:col-span-2">
          <h2 class="text-2xl font-bold text-ink">{home.contact.heading}</h2>
          <span class="mt-2 block h-1 w-12 rounded-full bg-marigold-500" aria-hidden="true"></span>
          <p class="mt-4 leading-relaxed text-ink-soft">
            {home.contact.body}
          </p>
          <p class="mt-4 text-sm text-ink-soft">
            Or email <a
              href={`mailto:${site.email}`}
              class="font-medium text-sindoor-700 hover:underline">{site.email}</a
            >
          </p>
        </div>
        <div class="lg:col-span-3">
          <ContactForm />
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
